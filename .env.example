# Pick one LLM provider for the resolver and listing parser.
# LLM_PROVIDER = anthropic | openai | groq | gemini | claude-cli | mock
# groq defaults to openai/gpt-oss-20b with reasoning_effort=low (free key at console.groq.com).
LLM_PROVIDER=mock
LLM_MODEL=
LLM_REASONING_EFFORT=
# groq falls over to qwen/qwen3.8-27b, then openai/gpt-oss-120b, when a model is rate-limited (429).
# Override with a comma list; set it to an empty value to turn fallback off.
# LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Nebius Token Factory: LLM_PROVIDER=nebius runs Nemotron 3 Nano, and escalates unsure comments and voice
# listings to Nemotron 3 Super. LLM_ESCALATE_MODEL overrides Super; set it empty to turn escalation off.
NEBIUS_API_KEY=
# LLM_ESCALATE_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Spend guard for pay-per-token keys: tokens one process may use (default 300000), and a date after which
# no LLM calls are made. Past either, comments resolve on the rules alone.
LLM_TOKEN_BUDGET=
LLM_DISABLE_AFTER=

# PayPal sandbox (US business account), filled after the Day-0 sandbox check
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
